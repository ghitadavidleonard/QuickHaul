<?xml version="1.0" encoding="utf-8"?>
<Application>
  <ActionDesign>
    <Actions>
      <Action Id="AssignAndDispatch" PaintStyle="CaptionAndImage" ImageMode="UseActionImage" Caption="Assign &amp; Dispatch" ImageName="Actions_Send" />
      <Action Id="CancelOrder" ImageName="del" />
      <Action Id="CloseOrder" ImageName="Check" />
      <Action Id="ConfirmDelivery" ImageName="ApplyChanges" />
      <Action Id="ConfirmPickup" ImageName="ApplyChanges" />
    </Actions>
  </ActionDesign>
  <BOModel>
    <Class Name="QuickHaul.Module.BusinessObjects.DeliveryEvent" DefaultListViewMasterDetailMode="ListViewOnly" />
    <Class Name="QuickHaul.Module.BusinessObjects.DeliveryOrder">
      <OwnMembers>
        <Member Name="CargoWeightKg" EditMask="n2" />
      </OwnMembers>
    </Class>
  </BOModel>
  <NavigationItems NavigationStyle="Accordion">
    <Items>
      <Item Id="ClientsNavigation" Caption="Clients" IsNewNode="True">
        <Items IsNewNode="True">
          <Item Id="Customer_ListView" ViewId="Customer_ListView" ObjectKey="" ImageName="BO_Customer" Caption="Customers" IsNewNode="True" />
        </Items>
      </Item>
      <Item Id="Default">
        <Items>
          <Item Id="Customer_ListView" ImageName="BO_Customer" Removed="True" />
          <Item Id="DeliveryOrder_ListView" ImageName="CustomerQuickSales" Removed="True" />
          <Item Id="Driver_ListView" ImageName="BO_Person" Removed="True" />
          <Item Id="Vehicle_ListView" ImageName="Travel_Car" Removed="True" />
        </Items>
      </Item>
      <Item Id="FleetNavigation" Caption="Fleet" IsNewNode="True">
        <Items IsNewNode="True">
          <Item Id="Driver_ListView" ViewId="Driver_ListView" ObjectKey="" ImageName="BO_Person" Caption="Drivers" IsNewNode="True" />
          <Item Id="Vehicle_ListView" ViewId="Vehicle_ListView" ObjectKey="" ImageName="Travel_Car" Caption="Vehicles" IsNewNode="True" />
        </Items>
      </Item>
      <Item Id="OperationsNavigation" Caption="Operations" IsNewNode="True">
        <Items IsNewNode="True">
          <Item Id="DeliveryOrder_ListView" ViewId="DeliveryOrder_ListView" ObjectKey="" ImageName="CustomerQuickSales" Caption="Delivery Orders" IsNewNode="True" />
        </Items>
      </Item>
    </Items>
  </NavigationItems>
  <Options UIType="TabbedMDI" FormStyle="Ribbon" RestoreTabbedMdiLayout="True" ShowTabImage="True" VirtualScrollingEnabled="True" />
  <SchemaModules>
    <SchemaModule Name="SystemModule" Version="25.2.5.0" IsNewNode="True" />
  </SchemaModules>
  <Views>
    <ListView Id="DeliveryEvent_ListView" DetailViewID="" AllowDelete="False">
      <Columns>
        <ColumnInfo Id="Timestamp" SortOrder="Descending" />
      </Columns>
    </ListView>
    <DetailView Id="DeliveryOrder_DetailView">
      <Items>
        <PropertyEditor Id="AssignedVehicle" LookupProperty="RegistrationPlate" />
      </Items>
      <Layout>
        <LayoutGroup Id="Main">
          <LayoutGroup Id="OrderInfo" Caption="Order Info" ShowCaption="True" Direction="Horizontal" Index="0" IsNewNode="True">
            <LayoutGroup Id="OrderInfo_col1" ShowCaption="False" IsNewNode="True">
              <LayoutItem Id="OrderNumber" ViewItem="OrderNumber" ShowCaption="" Index="0" IsNewNode="True" />
              <LayoutItem Id="Customer" ViewItem="Customer" ShowCaption="" Index="1" IsNewNode="True" />
              <LayoutItem Id="Status" ViewItem="Status" ShowCaption="" Index="2" IsNewNode="True" />
            </LayoutGroup>
            <LayoutGroup Id="OrderInfo_col2" ShowCaption="False" IsNewNode="True">
              <LayoutItem Id="RequestedPickupDate" ViewItem="RequestedPickupDate" ShowCaption="" Index="0" IsNewNode="True" />
              <LayoutItem Id="ActualDeliveryDate" ViewItem="ActualDeliveryDate" ShowCaption="" Index="1" IsNewNode="True" />
              <LayoutItem Id="ActualPickupDate" ViewItem="ActualPickupDate" ShowCaption="" Index="2" IsNewNode="True" />
            </LayoutGroup>
          </LayoutGroup>
          <LayoutGroup Id="CargoAssignment" Index="1" ShowCaption="False" IsNewNode="True">
            <LayoutGroup Id="Cargo" ShowCaption="True" Index="1" IsNewNode="True">
              <LayoutItem Id="CargoWeightKg" ViewItem="CargoWeightKg" ShowCaption="" Index="0" IsNewNode="True" />
              <LayoutItem Id="CargoDescription" ViewItem="CargoDescription" ShowCaption="" Index="1" IsNewNode="True" />
            </LayoutGroup>
            <LayoutGroup Id="Assignment" ShowCaption="True" IsNewNode="True">
              <LayoutItem Id="AssignedVehicle" ViewItem="AssignedVehicle" ShowCaption="" Index="0" IsNewNode="True" />
              <LayoutItem Id="AssignedDriver" ViewItem="AssignedDriver" ShowCaption="" Index="1" IsNewNode="True" />
            </LayoutGroup>
          </LayoutGroup>
          <LayoutGroup Id="Addresses" Index="2" ShowCaption="True" IsNewNode="True">
            <LayoutItem Id="PickupAddress" ViewItem="PickupAddress" ShowCaption="" Index="0" IsNewNode="True" />
            <LayoutItem Id="DeliveryAddress" ViewItem="DeliveryAddress" ShowCaption="" Index="1" IsNewNode="True" />
          </LayoutGroup>
          <LayoutGroup Id="NotesGroup" Caption="Notes" ShowCaption="True" Index="3" IsNewNode="True">
            <LayoutItem Id="Notes" ViewItem="Notes" ShowCaption="" Index="0" IsNewNode="True" />
          </LayoutGroup>
          <LayoutGroup Id="DeliveryEvents_Group" Index="4" />
          <LayoutGroup Id="SimpleEditors" Removed="True">
            <LayoutGroup Id="DeliveryOrder" Index="2" Removed="True">
              <LayoutGroup Id="DeliveryOrder_col1" Removed="True">
                <LayoutItem Id="ActualPickupDate" Removed="True" />
                <LayoutItem Id="CargoWeightKg" Removed="True" />
                <LayoutItem Id="Customer" Removed="True" />
                <LayoutItem Id="OrderNumber" Removed="True" />
                <LayoutItem Id="RequestedPickupDate" Removed="True" />
              </LayoutGroup>
              <LayoutGroup Id="DeliveryOrder_col2">
                <LayoutItem Id="ActualDeliveryDate" Removed="True" />
                <LayoutItem Id="AssignedDriver" Removed="True" />
                <LayoutItem Id="AssignedVehicle" Removed="True" />
                <LayoutItem Id="Status" Removed="True" />
              </LayoutGroup>
            </LayoutGroup>
          </LayoutGroup>
          <LayoutGroup Id="SizeableEditors" Removed="True">
            <LayoutItem Id="CargoDescription" Removed="True" />
            <LayoutItem Id="DeliveryAddress" Removed="True" />
            <LayoutItem Id="Notes" Removed="True" />
            <LayoutItem Id="PickupAddress" Removed="True" />
          </LayoutGroup>
        </LayoutGroup>
      </Layout>
    </DetailView>
    <ListView Id="DeliveryOrder_ListView">
      <Columns>
        <ColumnInfo Id="RequestedPickupDate" SortOrder="Descending" />
        <ColumnInfo Id="AssignedVehicle" LookupProperty="RegistrationPlate" />
      </Columns>
    </ListView>
    <DetailView Id="Driver_DetailView">
      <Items>
        <PropertyEditor Id="LicenseClasses" PropertyEditorType="QuickHaul.Blazor.Server.Editors.FlagsEnumPropertyEditor" />
      </Items>
    </DetailView>
  </Views>
</Application>